Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.81.0-noble

%files
    pixi.toml /opt/pristine/pixi.toml
    pixi.lock /opt/pristine/pixi.lock
    pyproject.toml /opt/pristine/pyproject.toml
    LICENSE /opt/pristine/LICENSE
    README.md /opt/pristine/README.md
    src /opt/pristine/src

%post
    cd /opt/pristine
    pixi install --locked
    pixi shell-hook -e default > /opt/pristine/shell-hook.sh

%runscript
    #!/bin/bash
    # Build from the repository root:  apptainer build pristine.sif PRISTINE/PRISTINE.def
    # Run from the directory holding config.yaml:  ./pristine.sif --config config.yaml
    source /opt/pristine/shell-hook.sh
    exec pristine "$@"
